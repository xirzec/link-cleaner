---
import LinkCleaner from '../components/LinkCleaner.astro';
import '../styles/global.css';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const faviconUrl = `${baseUrl}favicon.svg`;
const pageTitle = 'Link Cleaner - Share links, not trackers';
const pageDescription =
	'Remove tracking parameters from links before you share them. Everything stays in your browser.';
const socialDescription =
	'Share the link, not the tracking. Clean URLs privately in your browser.';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const socialImageUrl = new URL(`${baseUrl}social-preview.png`, Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={faviconUrl} />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={pageDescription} />
		<meta name="theme-color" content="#f4f8f7" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0b1414" media="(prefers-color-scheme: dark)" />
		<meta property="og:site_name" content="Link Cleaner" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={socialDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content="Link Cleaner - Share links, not trackers. Private and browser-only."
		/>
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={socialDescription} />
		<meta name="twitter:image" content={socialImageUrl} />
		<meta
			name="twitter:image:alt"
			content="Link Cleaner - Share links, not trackers. Private and browser-only."
		/>
		<title>{pageTitle}</title>
	</head>
	<body>
		<div class="page-glow page-glow--one" aria-hidden="true"></div>
		<div class="page-glow page-glow--two" aria-hidden="true"></div>

		<main class="page-shell">
			<header class="hero">
				<div class="brand">
					<span class="brand__mark" aria-hidden="true">
						<svg viewBox="0 0 24 24" role="img">
							<path d="M9.2 14.8 7.6 16.4a3.4 3.4 0 0 1-4.8-4.8l3.1-3.1a3.4 3.4 0 0 1 4.8 0" />
							<path d="m14.8 9.2 1.6-1.6a3.4 3.4 0 0 1 4.8 4.8l-3.1 3.1a3.4 3.4 0 0 1-4.8 0" />
							<path d="m8.7 15.3 6.6-6.6" />
						</svg>
					</span>
					<span>Link Cleaner</span>
				</div>

				<h1>Share links, <span>not trackers.</span></h1>
				<p class="hero__description">
					Paste a link and remove the tracking clutter in one tap. No uploads, no history,
					and no one looking over your shoulder.
				</p>
			</header>

			<LinkCleaner />

			<footer class="privacy-note">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<rect x="5" y="10" width="14" height="10" rx="2"></rect>
					<path d="M8.5 10V7.5a3.5 3.5 0 0 1 7 0V10"></path>
				</svg>
				<span>Your links never leave this device.</span>
			</footer>
		</main>
	</body>
</html>
