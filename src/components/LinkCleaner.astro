<section class="cleaner-card" aria-labelledby="cleaner-heading">
	<h2 id="cleaner-heading" class="visually-hidden">Clean a link</h2>

	<div class="field">
		<div class="field__heading">
			<label for="source-url">Link to clean</label>
			<div class="input-actions">
				<button id="clear-button" class="clear-button" type="button" disabled>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="m7 7 10 10M17 7 7 17"></path>
					</svg>
					<span>Clear</span>
				</button>
				<button id="paste-button" class="paste-button" type="button">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"></path>
						<rect x="9" y="3" width="6" height="4" rx="1"></rect>
					</svg>
					<span id="paste-label">Paste</span>
				</button>
			</div>
		</div>
		<textarea
			id="source-url"
			class="url-field"
			rows="4"
			placeholder="https://example.com/article?utm_source=newsletter"
			aria-describedby="source-hint source-error"
			autocomplete="off"
			autocapitalize="off"
			spellcheck="false"
		></textarea>
		<p id="source-hint" class="field__hint">
			Bare domains work too. We will add <code>https://</code> for you.
		</p>
		<p id="source-error" class="field__error" aria-live="polite" hidden></p>
	</div>

	<section id="result-panel" class="result-panel" aria-labelledby="result-heading" hidden>
		<div class="field__heading">
			<label id="result-heading" for="cleaned-url">Cleaned link</label>
			<span id="result-badge" class="result-badge" aria-live="polite">Ready to share</span>
		</div>

		<textarea
			id="cleaned-url"
			class="url-field url-field--result"
			rows="4"
			readonly
			aria-describedby="copy-status"
		></textarea>

		<button id="copy-button" class="copy-button" type="button" disabled>
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<rect x="8" y="8" width="11" height="11" rx="2"></rect>
				<path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
			</svg>
			<span id="copy-label">Copy cleaned link</span>
		</button>

		<p id="no-parameters" class="parameter-empty" hidden>No query parameters found.</p>

		<details id="parameter-review" class="parameter-review" hidden>
			<summary>
				<span class="parameter-review__title">Review parameters</span>
				<span id="parameter-summary" class="parameter-review__summary" aria-live="polite"></span>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="m8 10 4 4 4-4"></path>
				</svg>
			</summary>

			<div class="parameter-review__body">
				<div class="preset-toolbar">
					<span class="selection-status">
						Selection
						<strong id="selection-status">Recommended</strong>
					</span>
					<div class="preset-actions" role="group" aria-label="Parameter selection presets">
						<button
							id="recommended-preset"
							class="preset-button"
							type="button"
							aria-pressed="true">Recommended</button
						>
						<button
							id="remove-all-preset"
							class="preset-button"
							type="button"
							aria-pressed="false">Remove all</button
						>
					</div>
				</div>

				<p id="parameter-help" class="parameter-help">
					Tap a parameter to keep or remove every value for that key.
				</p>
				<ul
					id="parameter-list"
					class="parameter-list"
					aria-label="Query parameter removal choices"
					aria-describedby="parameter-help"
				></ul>
			</div>
		</details>

		<p id="copy-status" class="copy-status" role="status" aria-live="polite"></p>
	</section>
</section>

<script>
	import {
		analyzeUrl,
		applyParameterSelection,
		getPresetSelection,
		type CleanPreset,
		type SelectedQueryParameterGroup,
		type UrlAnalysis,
	} from '../lib/clean-url';

	function requireElement<T extends Element>(
		selector: string,
		elementType: new () => T,
	): T {
		const element = document.querySelector(selector);
		if (!(element instanceof elementType)) {
			throw new Error(`Link Cleaner could not initialize ${selector}.`);
		}

		return element;
	}

	const sourceInput = requireElement('#source-url', HTMLTextAreaElement);
	const sourceError = requireElement('#source-error', HTMLParagraphElement);
	const clearButton = requireElement('#clear-button', HTMLButtonElement);
	const pasteButton = requireElement('#paste-button', HTMLButtonElement);
	const pasteLabel = requireElement('#paste-label', HTMLElement);
	const resultPanel = requireElement('#result-panel', HTMLElement);
	const resultBadge = requireElement('#result-badge', HTMLElement);
	const cleanedOutput = requireElement('#cleaned-url', HTMLTextAreaElement);
	const copyButton = requireElement('#copy-button', HTMLButtonElement);
	const copyLabel = requireElement('#copy-label', HTMLElement);
	const noParameters = requireElement('#no-parameters', HTMLParagraphElement);
	const parameterReview = requireElement('#parameter-review', HTMLDetailsElement);
	const parameterSummary = requireElement('#parameter-summary', HTMLElement);
	const selectionStatus = requireElement('#selection-status', HTMLElement);
	const recommendedPreset = requireElement('#recommended-preset', HTMLButtonElement);
	const removeAllPreset = requireElement('#remove-all-preset', HTMLButtonElement);
	const parameterList = requireElement('#parameter-list', HTMLUListElement);
	const copyStatus = requireElement('#copy-status', HTMLParagraphElement);

	let analysis: UrlAnalysis | null = null;
	let removedParameterNames = new Set<string>();

	function resetCopyState() {
		copyButton.dataset.copied = 'false';
		copyLabel.textContent = 'Copy cleaned link';
		copyStatus.textContent = '';
	}

	function resetPasteState() {
		pasteButton.dataset.pasted = 'false';
		pasteLabel.textContent = 'Paste';
	}

	function selectionsMatch(left: ReadonlySet<string>, right: ReadonlySet<string>) {
		return left.size === right.size && [...left].every((parameterName) => right.has(parameterName));
	}

	function showParameters(parameters: SelectedQueryParameterGroup[]) {
		const items = parameters.map((parameter) => {
			const item = document.createElement('li');
			const button = document.createElement('button');
			const state = document.createElement('span');
			const code = document.createElement('code');
			const displayName = parameter.name || '(unnamed)';

			button.type = 'button';
			button.className = 'parameter-chip';
			button.dataset.parameterName = parameter.normalizedName;
			button.setAttribute('aria-pressed', String(parameter.removed));
			button.setAttribute(
				'aria-label',
				`${displayName}, ${parameter.count} ${parameter.count === 1 ? 'value' : 'values'}, ${
					parameter.removed ? 'removed. Activate to keep.' : 'kept. Activate to remove.'
				}`,
			);

			state.className = 'parameter-chip__state';
			state.textContent = parameter.removed ? 'Removed' : 'Kept';
			code.textContent = displayName;
			button.append(state, code);

			if (parameter.count > 1) {
				const count = document.createElement('span');
				count.className = 'parameter-chip__count';
				count.textContent = `x${parameter.count}`;
				button.append(count);
			}

			item.append(button);
			return item;
		});

		parameterList.replaceChildren(...items);
	}

	function updatePresetState() {
		if (!analysis) {
			return;
		}

		const recommendedSelection = getPresetSelection(analysis.parameters, 'tracking');
		const allSelection = getPresetSelection(analysis.parameters, 'all');
		const isRecommended = selectionsMatch(removedParameterNames, recommendedSelection);
		const isRemoveAll = selectionsMatch(removedParameterNames, allSelection);

		recommendedPreset.setAttribute('aria-pressed', String(isRecommended));
		removeAllPreset.setAttribute('aria-pressed', String(isRemoveAll));
		selectionStatus.textContent = isRecommended
			? 'Recommended'
			: isRemoveAll
				? 'All removed'
				: 'Custom';
	}

	function renderSelection() {
		if (!analysis) {
			return;
		}

		resetCopyState();
		const result = applyParameterSelection(analysis, removedParameterNames);

		cleanedOutput.value = result.url;
		copyButton.disabled = false;

		const removedNoun = result.removedParameterCount === 1 ? 'parameter' : 'parameters';
		resultBadge.textContent =
			result.removedParameterCount > 0
				? `${result.removedParameterCount} ${removedNoun} removed`
				: 'Already clean';

		const hasParameters = analysis.parameterCount > 0;
		noParameters.hidden = hasParameters;
		parameterReview.hidden = !hasParameters;

		if (hasParameters) {
			parameterSummary.textContent =
				`${result.removedParameterCount} removed, ${result.keptParameterCount} kept`;
			showParameters(result.parameters);
			updatePresetState();
		} else {
			parameterReview.open = false;
			parameterList.replaceChildren();
		}
	}

	function updateFromInput() {
		clearButton.disabled = sourceInput.value.length === 0;
		const result = analyzeUrl(sourceInput.value);

		if (!result.ok) {
			analysis = null;
			removedParameterNames.clear();
			resultPanel.hidden = true;
			cleanedOutput.value = '';
			copyButton.disabled = true;
			parameterList.replaceChildren();

			const hasInput = result.code !== 'empty';
			sourceError.hidden = !hasInput;
			sourceError.textContent = hasInput ? result.message : '';
			sourceInput.toggleAttribute('aria-invalid', hasInput);
			return;
		}

		analysis = result;
		removedParameterNames = getPresetSelection(result.parameters, 'tracking');
		sourceError.hidden = true;
		sourceError.textContent = '';
		sourceInput.removeAttribute('aria-invalid');
		resultPanel.hidden = false;
		renderSelection();
	}

	function applyPreset(preset: CleanPreset) {
		if (!analysis) {
			return;
		}

		removedParameterNames = getPresetSelection(analysis.parameters, preset);
		if (preset === 'all') {
			parameterReview.open = true;
		}
		renderSelection();
	}

	sourceInput.addEventListener('input', () => {
		resetPasteState();
		updateFromInput();
	});

	clearButton.addEventListener('click', () => {
		sourceInput.value = '';
		resetPasteState();
		updateFromInput();
		sourceInput.focus();
	});

	pasteButton.addEventListener('click', async () => {
		resetPasteState();
		sourceError.hidden = true;
		sourceError.textContent = '';
		sourceInput.removeAttribute('aria-invalid');

		if (!navigator.clipboard || typeof navigator.clipboard.readText !== 'function') {
			sourceError.hidden = false;
			sourceError.textContent =
				'Clipboard access is unavailable in this browser. You can still paste into the field manually.';
			sourceInput.focus();
			return;
		}

		try {
			const clipboardText = await navigator.clipboard.readText();
			if (!clipboardText.trim()) {
				sourceError.hidden = false;
				sourceError.textContent = 'Your clipboard does not contain a link.';
				sourceInput.focus();
				return;
			}

			sourceInput.value = clipboardText;
			updateFromInput();
			pasteButton.dataset.pasted = 'true';
			pasteLabel.textContent = 'Pasted';
			sourceInput.focus();
		} catch (error) {
			console.error('Unable to read a link from the clipboard.', error);
			sourceError.hidden = false;
			sourceError.textContent =
				'Clipboard permission was denied. You can still paste into the field manually.';
			sourceInput.focus();
		}
	});

	recommendedPreset.addEventListener('click', () => applyPreset('tracking'));
	removeAllPreset.addEventListener('click', () => applyPreset('all'));

	parameterList.addEventListener('click', (event) => {
		if (!(event.target instanceof Element)) {
			return;
		}

		const button = event.target.closest<HTMLButtonElement>('button[data-parameter-name]');
		const parameterName = button?.dataset.parameterName;
		if (parameterName === undefined) {
			return;
		}

		if (removedParameterNames.has(parameterName)) {
			removedParameterNames.delete(parameterName);
		} else {
			removedParameterNames.add(parameterName);
		}
		renderSelection();
	});

	copyButton.addEventListener('click', async () => {
		const url = cleanedOutput.value;
		if (!url) {
			copyStatus.textContent = 'There is no cleaned link to copy.';
			return;
		}

		if (!navigator.clipboard) {
			cleanedOutput.focus();
			cleanedOutput.select();
			copyStatus.textContent = 'Clipboard access is unavailable. The cleaned link is selected for you.';
			return;
		}

		try {
			await navigator.clipboard.writeText(url);
			copyButton.dataset.copied = 'true';
			copyLabel.textContent = 'Copied';
			copyStatus.textContent = 'Cleaned link copied to your clipboard.';
		} catch (error) {
			console.error('Unable to copy the cleaned link.', error);
			cleanedOutput.focus();
			cleanedOutput.select();
			copyStatus.textContent = 'Copy failed. The cleaned link is selected so you can copy it manually.';
		}
	});
</script>
